# Doxygen configuration for the ESP32 Ethernet library.
# Usage:  doxygen Doxyfile    ->  docs/html/index.html

PROJECT_NAME           = "ESP32 Ethernet"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Arduino-style Ethernet wrapper for ESP-IDF (W5500, DM9051, KSZ8851SNL, internal EMAC)"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TAB_SIZE               = 4

# Input
INPUT                  = README.md Ethernet.h
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md
EXAMPLE_PATH           = examples
EXAMPLE_PATTERNS       = *.cpp
EXAMPLE_RECURSIVE      = YES

# Extraction
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
SORT_MEMBER_DOCS       = NO
INLINE_SOURCES         = NO
SOURCE_BROWSER         = YES
VERBATIM_HEADERS       = YES

# Preprocessor: document every hardware option regardless of sdkconfig
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
PREDEFINED             = __DOXYGEN__ \
                         CONFIG_ETH_USE_SPI_ETHERNET=1 \
                         CONFIG_ETH_USE_ESP32_EMAC=1

# Warnings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen_warnings.log

# Output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
